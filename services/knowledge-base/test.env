# Test configuration для Knowledge Base Service (без внешних зависимостей)

# Сервер
KNOWLEDGE_BASE_PORT=3002
KNOWLEDGE_BASE_HOST=0.0.0.0

# Weaviate (в тестовом режиме будет мок)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_CLASS_NAME=PMACDocument

# AI Configuration - тестовый режим без реальных API
AI_PROVIDER=test
OPENROUTER_API_KEY=test_key
AI_MODEL=test-model
EMBEDDING_MODEL=test-embedding

# Загрузка файлов
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,html,md

# Обработка документов
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_CONCURRENT_JOBS=1

# Логирование
LOG_LEVEL=info
LOG_DIR=./logs

# Разработка
NODE_ENV=test
