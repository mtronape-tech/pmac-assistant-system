# Knowledge Base Service Configuration

# Сервер
KNOWLEDGE_BASE_PORT=3002
KNOWLEDGE_BASE_HOST=0.0.0.0

# Weaviate (векторная база данных)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_CLASS_NAME=PMACDocument
# WEAVIATE_API_KEY=your_weaviate_api_key_if_needed

# AI Configuration
AI_PROVIDER=openrouter  # openai или openrouter

# OpenAI (если используется)
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4000

# OpenRouter (рекомендуется - есть бесплатные модели)
OPENROUTER_API_KEY=your_openrouter_api_key
AI_MODEL=openai/gpt-oss-20b:free  # Бесплатная модель от OpenAI
EMBEDDING_MODEL=openai/text-embedding-3-small
AI_MAX_TOKENS=4000

# Загрузка файлов
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB в байтах
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,html,md

# Обработка документов
CHUNK_SIZE=1000  # Размер чанка в символах
CHUNK_OVERLAP=200  # Перекрытие между чанками
MAX_CONCURRENT_JOBS=3  # Максимум задач обработки одновременно

# Логирование
LOG_LEVEL=info  # debug, info, warn, error
LOG_DIR=./logs

# Разработка
NODE_ENV=development
