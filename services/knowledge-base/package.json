{
  "name": "@pmac/knowledge-base-service",
  "version": "1.0.0",
  "type": "module",
  "description": "Knowledge Base Service - микросервис для управления базой знаний PMAC Assistant System",
  "main": "dist/index.js",
  "scripts": {
    "build": "echo '🔨 Начинаем сборку Knowledge Base...' && echo '📁 Текущая директория:' && cd && echo '📂 Содержимое src:' && dir src && echo '⚙️  Запуск TypeScript компилятора...' && tsc --listFiles && echo '✅ Сборка завершена' && echo '📂 Содержимое dist:' && dir dist",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx --watch src/index.ts",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.ts",
    "test": "jest",

    "test-client": "node test-kb-client.js"
  },
  "keywords": [
    "pmac",
    "knowledge-base",
    "vector-database",
    "weaviate",
    "ai",
    "embeddings",
    "documentation",
    "microservice"
  ],
  "author": "PMAC Assistant System",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "vectra": "^0.11.1",
    "openai": "^4.20.1",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "fs-extra": "^11.1.1",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "@types/multer": "^1.4.11",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.3.3",
    "tsx": "^4.6.2",
    "rimraf": "^5.0.5",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  }
}
