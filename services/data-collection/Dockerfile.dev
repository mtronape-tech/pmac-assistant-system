FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
COPY tsconfig.json ./
RUN npm install

# Copy shared types
COPY ../../packages/shared-types ./packages/shared-types

# Copy source code
COPY src/ ./src/

# Create logs directory
RUN mkdir -p logs

# Expose port
EXPOSE 3008

# Development command
CMD ["npm", "run", "dev"]
