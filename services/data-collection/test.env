# Тестовая конфигурация для Data Collection Service
NODE_ENV=test

# Server
PORT=3001
HOST=localhost

# Database (используем PostgreSQL в WSL)
DB_HOST=172.21.118.8
DB_PORT=5432
DB_NAME=pmac_assistant
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis (используем Redis в WSL)
REDIS_HOST=172.21.118.8
REDIS_PORT=6379
REDIS_DB=1

# PMAC Control (отключаем для тестов, будем мокать)
PMAC_CONTROL_BASE_URL=http://localhost:3007
PMAC_CONTROL_ENABLED=false
PMAC_CONTROL_TIMEOUT=5000

# Collection
COLLECTION_ENABLED=true
COLLECTION_INTERVAL=2000
COLLECTION_BATCH_SIZE=10
COLLECTION_RETENTION_DAYS=7
COLLECTION_MAX_RETRIES=2

# Logging
LOG_LEVEL=debug
LOG_FORMAT=simple
