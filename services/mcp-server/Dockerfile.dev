FROM node:18-alpine

WORKDIR /app

# Копируем файлы конфигурации
COPY package*.json ./
COPY tsconfig.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем исходный код
COPY src/ ./src/

# Собираем проект
RUN npm run build

# Открываем порт
EXPOSE 3001

# Запускаем в режиме разработки
CMD ["npm", "run", "dev"]
