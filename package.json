{
  "name": "pmac-assistant-system",
  "version": "1.0.0",
  "description": "Интеллектуальный помощник для наладчиков станков с ЧПУ",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd packages/web-frontend ; npm run dev",
    "dev:backend": "cd services/knowledge-base ; npm run dev",
    "build": "npm run build:frontend ; npm run build:backend",
    "build:frontend": "cd packages/web-frontend ; npm run build",
    "build:backend": "cd services/knowledge-base ; npm run build",
    "start": "npm run start:frontend & npm run start:backend",
    "start:frontend": "cd packages/web-frontend ; npm start",
    "start:backend": "cd services/knowledge-base ; npm start",
    "test": "npm run test:frontend ; npm run test:backend",
    "test:frontend": "cd packages/web-frontend ; npm test",
    "test:backend": "cd services/knowledge-base ; npm test",
    "clean": "npm run clean:frontend ; npm run clean:backend",
    "clean:frontend": "cd packages/web-frontend ; rm -rf .next out",
    "clean:backend": "cd services/knowledge-base ; rm -rf dist",
    "install:all": "npm install ; cd packages/web-frontend ; npm install ; cd ../../services/knowledge-base ; npm install"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/pmac-assistant-system.git"
  },
  "keywords": [
    "pmac",
    "cnc",
    "industrial",
    "ai",
    "mcp",
    "automation"
  ],
  "author": "PMAC Assistant Team",
  "license": "MIT",
  "dependencies": {
    "vectra": "^0.11.1"
  }
}
